# BUILD:
#   docker build -t wireviz -f render/Dockerfile-wireviz .

FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get -y --no-install-recommends install graphviz fonts-liberation && \
    rm -rf /var/lib/apt/lists/*

# Pin to the version LumenPnP already uses in CI.
RUN pip install --no-cache-dir "wireviz==0.3.2"

COPY . /autobom
RUN chmod +x /autobom/render/wcad-entry.sh

CMD ["/autobom/render/wcad-entry.sh"]
